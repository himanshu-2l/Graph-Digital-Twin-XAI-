    "## Section 3: Explainable AI (XAI) Dashboard\n",
    "\n",
    "In safety-critical infrastructure, it is not enough to raise an alarm; grid operators must understand exactly which buses are compromised.\n",
    "\n",
    "We implement **Integrated Gradients (IG)**. IG tracks the gradients of the model's prediction score with respect to each input feature, starting from a baseline (nominal all-zero state) to the active operating state. This assigns a physical attribution score to each bus, identifying the root-cause sensors.\n",
    "\n",
    "The code below:\n",
    "1. Selects an attacked sample from the dataset.\n",
    "2. Computes the Integrated Gradients attribution weights.\n",
    "3. Renders a side-by-side dashboard comparing localization predictions and XAI attribution scores."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "import numpy as np\n",
    "import networkx as nx\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def compute_integrated_gradients(model, x, edge_index, target_class=1, steps=50):\n",
    "    model.eval()\n",
    "    baseline = torch.zeros_like(x)\n",
    "    accumulated_grads = torch.zeros_like(x)\n",
    "    \n",
    "    for step in range(steps + 1):\n",
    "        alpha = step / steps\n",
    "        x_interpolated = baseline + alpha * (x - baseline)\n",
    "        x_interpolated.requires_grad = True\n",
    "        \n",
    "        _, graph_logits = model(x_interpolated, edge_index)\n",
    "        prob = torch.sigmoid(graph_logits.squeeze(-1))\n",
    "        \n",
    "        model.zero_grad()\n",
    "        prob.backward(retain_graph=True)\n",
    "        \n",
    "        if x_interpolated.grad is not None:\n",
    "            accumulated_grads += x_interpolated.grad\n",
    "            \n",
    "    avg_grads = accumulated_grads / (steps + 1)\n",
    "    attributions = (x - baseline) * avg_grads\n",
    "    return attributions.detach().cpu().numpy()\n",
    "\n",
    "# Load best GraphSAGE model\n",
    "model = SAGEModel(in_channels=4, hidden_channels=32).to(device)\n",
    "model.load_state_dict(torch.load('best_model.pt', map_location=device))\n",
    "model.eval()\n",
    "\n",
    "# Select first attack sample in test dataset\n",
    "attack_sample = None\n",
    "for data in test_dataset:\n",
    "    if data.y_graph.item() == 1.0:\n",
    "        attack_sample = data\n",
    "        break\n",
    "\n",
    "if attack_sample is not None:\n",
    "    x_dev = attack_sample.x.to(device)\n",
    "    edge_index_dev = attack_sample.edge_index.to(device)\n",
    "    \n",
    "    with torch.no_grad():\n",
    "        node_logits, graph_logits = model(x_dev, edge_index_dev)\n",
    "        pred_prob = torch.sigmoid(graph_logits.squeeze(-1)).item()\n",
    "        node_preds = torch.argmax(node_logits, dim=-1).cpu().numpy()\n",
    "        \n",
    "    ground_truth = attack_sample.y_node.numpy()\n",
    "    edge_index = attack_sample.edge_index.cpu().numpy()\n",
    "    \n",
    "    # Compute attributions\n",
    "    attributions = compute_integrated_gradients(model, x_dev, edge_index_dev)\n",
    "    node_attributions = attributions.sum(axis=1)\n",
    "    \n",
    "    print(f\"Attack Detection Probability: {pred_prob*100:.2f}%\")\n",
    "    print(f\"Compromised nodes in Ground Truth: {np.where(ground_truth == 1)[0]}\")\n",
    "    print(f\"GNN Localized compromised nodes:   {np.where(node_preds == 1)[0]}\")\n",
    "    \n",
    "    G = nx.Graph()\n",
    "    for i in range(len(node_attributions)):\n",
    "        G.add_node(i)\n",
    "    for u, v in edge_index.T:\n",
    "        G.add_edge(int(u), int(v))\n",
    "        \n",
    "    pos = nx.kamada_kawai_layout(G)\n",
    "    \n",
    "    fig, axes = plt.subplots(1, 2, figsize=(18, 8))\n",
    "    \n",
    "    # PANEL 1: Ground Truth vs GNN Localization\n",
    "    ax1 = axes[0]\n",
    "    ax1.set_title(f\"GNN Cyberattack Localization (P(Attack) = {pred_prob:.4f})\", fontsize=14, fontweight='bold')\n",
    "    \n",
    "    node_colors = []\n",
    "    labels = {}\n",
    "    for i in range(len(node_attributions)):\n",
    "        gt = ground_truth[i]\n",
    "        pred = node_preds[i]\n",
    "        labels[i] = f\"Bus {i}\\n(Nominal)\"\n",
    "        \n",
    "        if gt == 1 and pred == 1:\n",
    "            node_colors.append('#e74c3c') # Red (True Positive)\n",
    "            labels[i] = f\"Bus {i}\\n[ATTACK]\"\n",
    "        elif gt == 0 and pred == 1:\n",
    "            node_colors.append('#f39c12') # Orange (False Positive)\n",
    "            labels[i] = f\"Bus {i}\\n[FP]\"\n",
    "        elif gt == 1 and pred == 0:\n",
    "            node_colors.append('#3498db') # Blue (False Negative)\n",
    "            labels[i] = f"Bus {i}\\n[FN]"\n",
    "        else:\n",
    "            node_colors.append('#2ecc71') # Green (True Negative)\n",
    "            \n",
    "    nx.draw_networkx_edges(G, pos, ax=ax1, width=1.5, edge_color='#bdc3c7')\n",
    "    nx.draw_networkx_nodes(G, pos, ax=ax1, node_size=900, node_color=node_colors, edgecolors='#2c3e50', linewidths=1.5)\n",
    "    nx.draw_networkx_labels(G, pos, labels=labels, ax=ax1, font_size=8, font_weight='bold')\n",
    "    \n",
    "    from matplotlib.patches import Patch\n",
    "    legend_elements = [\n",
    "        Patch(facecolor='#2ecc71', edgecolor='#2c3e50', label='Benign (True Negative)'),\n",
    "        Patch(facecolor='#e74c3c', edgecolor='#2c3e50', label='Compromised (True Positive)'),\n",
    "        Patch(facecolor='#f39c12', edgecolor='#2c3e50', label='False Positive Anomaly'),\n",
    "        Patch(facecolor='#3498db', edgecolor='#2c3e50', label='False Negative (Missed)')\n",
    "    ]\n",
    "    ax1.legend(handles=legend_elements, loc='upper left', frameon=True)\n",
    "    ax1.set_axis_off()\n",
    "    \n",
    "    # PANEL 2: Integrated Gradients Attribution Heatmap\n",
    "    ax2 = axes[1]\n",
    "    ax2.set_title(\"XAI: Integrated Gradients Attribution Heatmap\", fontsize=14, fontweight='bold')\n",
    "    \n",
    "    pos_attributions = np.maximum(node_attributions, 0)\n",
    "    max_val = pos_attributions.max() if pos_attributions.max() > 0 else 1.0\n",
    "    norm_attributions = pos_attributions / max_val\n",
    "    \n",
    "    cmap = plt.cm.Oranges\n",
    "    xai_colors = [cmap(val) for val in norm_attributions]\n",
    "    xai_labels = {i: f\"Bus {i}\\nScore: {node_attributions[i]:.2f}\" for i in range(len(node_attributions))}\n",
    "    \n",
    "    nx.draw_networkx_edges(G, pos, ax=ax2, width=1.5, edge_color='#bdc3c7')\n",
    "    nx.draw_networkx_nodes(G, pos, ax=ax2, node_size=900, node_color=xai_colors, edgecolors='#2c3e50', linewidths=1.5)\n",
    "    nx.draw_networkx_labels(G, pos, labels=xai_labels, ax=ax2, font_size=8, font_weight='bold')\n",
    "    \n",
    "    sm = plt.cm.ScalarMappable(cmap=cmap, norm=plt.Normalize(vmin=0, vmax=max_val))\n",
    "    sm.set_array([])\n",
    "    cbar = plt.colorbar(sm, ax=ax2, orientation='vertical', shrink=0.7)\n",
    "    cbar.set_label('Integrated Gradients Attribution Weight', fontsize=10, fontweight='bold')\n",
    "    ax2.set_axis_off()\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "else:\n",
    "    print(\"Error: Could not retrieve an attack sample.\")"
   ]
