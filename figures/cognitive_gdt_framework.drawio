        <!-- Stage 1: Observe & Synchronize -->
        <mxCell id="stage1" value="&lt;b&gt;1. OBSERVE &amp; SYNCHRONIZE&lt;/b&gt;&#10;• Real-Time Telemetry Normalization&#10;• Dynamic Graph Mapping G = (V, E, Y_bus)&#10;• Rolling Baseline Update (z_baseline)&#10;• Cycle Latency: 0.12 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=0;fontSize=10;fontColor=#075985;align=left;spacingLeft=10;" vertex="1" parent="c3">
          <mxGeometry x="25" y="45" width="335" height="115" as="geometry" />
        </mxCell>

        <!-- Stage 2: Learn & Detect -->
        <mxCell id="stage2" value="&lt;b&gt;2. LEARN &amp; MULTI-TASK INFERENCE&lt;/b&gt;&#10;• Multi-Task Admittance-Conditioned GraphSAGE&#10;• &lt;b&gt;Detection Head (Graph):&lt;/b&gt; 98.25% ± 0.34% F1 (AUC 0.9993)&#10;• &lt;b&gt;Localization Head (Node):&lt;/b&gt; 97.62% ± 0.84% F1 (MCC 0.982)&#10;• Status: &lt;font color='#DC2626'&gt;&lt;b&gt;ATTACK DETECTED — BUS 5 COMPROMISED ⚠&lt;/b&gt;&lt;/font&gt;&#10;• Inference Latency: 0.908 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=0;fontSize=10;fontColor=#14532D;align=left;spacingLeft=10;" vertex="1" parent="c3">
          <mxGeometry x="400" y="45" width="335" height="115" as="geometry" />
        </mxCell>

        <!-- Stage 3: Reason & Explain -->
        <mxCell id="stage3" value="&lt;b&gt;3. REASON &amp; AXIOMATIC EXPLAINABILITY&lt;/b&gt;&#10;• Attribution-Guided Loss: L_total = L_BCE + 1.5 L_WCE + 0.3 L_align&#10;• Integrated Gradients (50 Riemann Steps, Completeness Axiom)&#10;• &lt;b&gt;Bus 5 Attribution Breakdown:&lt;/b&gt;&#10;   - Voltage Phase Angle (θ): &lt;b&gt;0.486&lt;/b&gt; (Dominant Jacobian Vector)&#10;   - Reactive Power Injection (Q): &lt;b&gt;0.254&lt;/b&gt;&#10;   - Active Power Injection (P): &lt;b&gt;0.112&lt;/b&gt; | Voltage Mag (V): &lt;b&gt;0.034&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=0;fontSize=10;fontColor=#78350F;align=left;spacingLeft=10;" vertex="1" parent="c3">
          <mxGeometry x="400" y="210" width="335" height="145" as="geometry" />
        </mxCell>

        <!-- Stage 4: Act & Heal -->
        <mxCell id="stage4" value="&lt;b&gt;4. ACT &amp; AUTONOMOUS SPATIAL HEALING&lt;/b&gt;&#10;• &lt;b&gt;Step 1: Automated RTU Quarantine&lt;/b&gt; (Isolate corrupted Bus 5 channels)&#10;• &lt;b&gt;Step 2: Admittance-Weighted Spatial Reconstruction:&lt;/b&gt;&#10;   z_recon,k = [ ∑_(j∈N(k)) |Y_kj| · z_j ] / [ ∑ |Y_kj| ] + δ&#10;• &lt;b&gt;WLS State Error Recovery:&lt;/b&gt; MSE 0.007228 → 0.000002 p.u.^2 (&lt;b&gt;99.97%&lt;/b&gt;)&#10;• &lt;b&gt;Total Response Time:&lt;/b&gt; &lt; 2 ms (&lt;font color='#16A34A'&gt;&lt;b&gt;&lt;&lt; 100 ms IEC 60601-1 Trip Limit&lt;/b&gt;&lt;/font&gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=0;fontSize=10;fontColor=#7F1D1D;align=left;spacingLeft=10;" vertex="1" parent="c3">
          <mxGeometry x="25" y="210" width="335" height="145" as="geometry" />
        </mxCell>

