        <!-- OT Field Layer -->
        <mxCell id="ot_layer" value="OT Field Telemetry Layer&#10;Substation Busbars • Remote Terminal Units (RTUs) • PMUs • Circuit Breakers&#10;Real-Time Telemetry: z_SCADA = [V, θ, P, Q]^T (Sampling Period Ts = 2–4s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontStyle=1;fontSize=10;fontColor=#14532D;" vertex="1" parent="c1">
