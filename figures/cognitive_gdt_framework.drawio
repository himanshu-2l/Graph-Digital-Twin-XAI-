        <!-- Cyber Threat Surface Box -->
        <mxCell id="threat_box" value="&lt;b&gt;Cyber Threat Surface: Stealthy Jacobian FDIA (a = H c)&lt;/b&gt;&#10;Adversary corrupts Bus 5 (ICU Feeder) telemetry: z_comp = z + Hc&#10;Classical Weighted Least Squares Bad-Data Residual: r_comp = ||z_comp - h(x_comp)||^2_R^-1 ≤ τ_χ^2&#10;Result: 100% Classical BDD Detection Bypass (BDD Blind to State Corruption)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=0;fontSize=10;fontColor=#991B1B;align=left;spacingLeft=12;" vertex="1" parent="c1">
          <mxGeometry x="25" y="520" width="480" height="85" as="geometry" />
        </mxCell>

        <!-- Biomedical Electrical Standards Compliance Box -->
        <mxCell id="standards_box" value="&lt;b&gt;Biomedical Safety Standard (IEC 60601-1 &amp; IEEE 1547)&lt;/b&gt;&#10;Voltage Fluctuation Limit: ±5% Deviation&#10;Maximum Allowable Sag Duration: 100 ms (Longer sags trip mechanical ventilator motor drives)&#10;System Requirement: Autonomous Cyber-Physical State Restoration within &lt; 100 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontStyle=0;fontSize=9.5;fontColor=#78350F;align=left;spacingLeft=12;" vertex="1" parent="c1">
