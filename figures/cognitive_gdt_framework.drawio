        <!-- =================================================================== -->
        <mxCell id="c3" value="3. Cognitive Multi-Task Decision, Explainability &amp; Closed-Loop Healing Cycle" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0284C7;fontStyle=1;fontSize=13;fontColor=#0369A1;startSize=32;rounded=1;arcSize=3;shadow=1;" vertex="1" parent="1">
